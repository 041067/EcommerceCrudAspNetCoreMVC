@{
    ViewData["Title"] = "Confirmação de Compra";
}

<div class="confirmacao-wrapper">
    <div style="max-width: 600px; margin: 0 auto;">
        <h2 style="color: #00ff9c;">✅ Compra Confirmada!</h2>
        <p style="font-size: 18px;">Sua compra foi registrada com sucesso.</p>
        <p>Em breve você receberá mais informações sobre o seu pedido.</p>

        <div class="confirmacao-actions">
            <a href="/Produto" class="btn btn-primary btn-lg">🛍️ Continuar Comprando</a>
            <a href="/Usuario/Perfil" class="btn btn-outline-secondary btn-lg">👤 Ver Meu Perfil</a>
        </div>
    </div>
</div>
