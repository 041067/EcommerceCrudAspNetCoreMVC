@model Esse_deu_certo_MVC_Exemplo.Models.Dashboard
@using Newtonsoft.Json

@{
    ViewData["Title"] = "Painel do Administrador";
    var categorias = ViewBag.Categorias as IEnumerable<dynamic> ?? Enumerable.Empty<dynamic>();
}

<div class="dashboard-header">
    <a asp-controller="Admin" asp-action="Dashboard" class="btn btn-secondary">🏠 Dashboard</a>
    <a asp-controller="Admin" asp-action="CadastrarProduto" class="btn btn-primary">➕ Cadastrar Produto</a>
    <a href="/Admin/Produtos" class="btn btn-info">📦 Gerenciar Produtos</a>
    <a href="/Admin/Usuarios" class="btn btn-danger">👨‍💼 Gerenciar Usuários</a>
    <a asp-controller="Categoria" asp-action="Index" class="btn btn-warning">📁 Categorias</a>
    <a asp-controller="Usuario" asp-action="Logout" class="btn btn-danger" style="margin-left: auto;">🚪 Sair</a>
</div>


<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<div class="container mt-4">
    <h2 class="text-center mb-4">📊 Dashboard Administrativo</h2>

    <!-- Cards de Resumo -->
    <div class="row mb-4 text-center">
        <div class="col-md-4">
            <div class="card stat-card" style="border-color: rgba(13, 110, 253, 0.4) !important;">
                <div class="card-body">
                    <h4 style="color: #0d6efd;">📦 Total de Produtos</h4>
                    <h2>@Model.TotalProdutos</h2>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card stat-card" style="border-color: rgba(0, 255, 156, 0.4) !important;">
                <div class="card-body">
                    <h4 style="color: #00ff9c;">💰 Faturamento Total</h4>
                    <h2>R$ @Model.FaturamentoTotal.ToString("F2")</h2>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card stat-card" style="border-color: rgba(255, 193, 7, 0.4) !important;">
                <div class="card-body">
                    <h4 style="color: #ffc107;">📁 Total de Categorias</h4>
                    <h2>@Model.TotalCategorias</h2>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-md-6 mb-4">
            <div class="chart-card">
                <h5>📊 Produtos por Categoria</h5>
                <canvas id="graficoProdutos"></canvas>
            </div>
        </div>

        <div class="col-md-6 mb-4">
            <div class="chart-card">
                <h5>📈 Faturamento por Categoria</h5>
                <canvas id="graficoFaturamento"></canvas>
            </div>
        </div>

        <div class="col-12">
            <div class="alert text-center" style="border-color: rgba(0, 255, 156, 0.3);">
                <h4 style="color: #00ff9c;">💰 Faturamento Total: R$ @ViewBag.TotalFaturamento.ToString("F2")</h4>
            </div>
        </div>
    </div>
</div>

<script>
    const categorias = @Html.Raw(JsonConvert.SerializeObject(Model.Categorias.Select(c => c.Categoria)));
    const totais = @Html.Raw(JsonConvert.SerializeObject(Model.Categorias.Select(c => c.TotalProdutos)));
    const faturamentos = @Html.Raw(JsonConvert.SerializeObject(Model.Categorias.Select(c => c.Faturamento)));

    // Gráfico 1 - Produtos por Categoria
    new Chart(document.getElementById('graficoProdutos'), {
        type: 'bar',
        data: {
            labels: categorias,
            datasets: [{
                label: 'Quantidade de Produtos',
                data: totais,
                backgroundColor: '#0d6efd',
                borderColor: '#0d6efd',
                borderRadius: 6
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: true,
            plugins: {
                legend: {
                    labels: { color: '#e0e0e0' }
                }
            },
            scales: {
                y: {
                    beginAtZero: true,
                    ticks: { color: '#a0a0a0' },
                    grid: { color: 'rgba(255,255,255,0.05)' }
                },
                x: {
                    ticks: { color: '#a0a0a0' },
                    grid: { color: 'rgba(255,255,255,0.05)' }
                }
            }
        }
    });

    new Chart(document.getElementById('graficoFaturamento'), {
        type: 'pie',
        data: {
            labels: categorias,
            datasets: [{
                label: 'Faturamento (R$)',
                data: faturamentos,
                backgroundColor: ['#00f7ff', '#00ff9c', '#ffc107', '#0d6efd', '#6f42c1', '#ff6b6b'],
                borderColor: 'rgba(10,10,30,0.5)',
                borderWidth: 2
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: true,
            plugins: {
                legend: {
                    labels: { color: '#e0e0e0' }
                }
            }
        }
    });
</script>