@{
    ViewData["Title"] = "Home Page";
}

<section class="hero">

    <img src="/images/banner_mercado_livre.jpg"
         alt="Banner Mercado Livre"
         class="hero-image">

    <div class="hero-content">

        <h1 class="hero-title">
            Bem-vindo ao Mercado Livre
        </h1>

        <p class="hero-subtitle">
            Sua próxima compra a um clique
        </p>

        <p class="hero-ai-text">
            <span id="typed"></span>
        </p>

        <div class="hero-buttons">
            <a href="/Usuario/Login" class="btn btn-outline-light btn-lg">Login</a>
            <a href="/Usuario/Cadastrar" class="btn btn-outline-light btn-lg">Cadastrar</a>
        </div>

    </div>

</section>

<div id="myPlot" style="width:100%;max-width:900px"></div>

<script>

    const xArray = ["Sudeste", "Centro-Oeste", "Norte", "Sul", "Nordeste"];
    const yArray = [57, 10, 9, 17, 7];

    const data = [{
        labels: xArray,
        values: yArray,
        type: "pie",
        hole: .30,
        textinfo: "label+percent",
        hoverinfo: "label+percent+value",
        marker: {
            colors: [
                "#80CBC4", // Verde-água pastel
"#90CAF9", // Azul pastel
"#A5D6A7", // Verde pastel
"#EF9A9A", // Vermelho pastel
"#CE93D8"  // Roxo pastel
            ]
        }
    }];

    const layout = {
        title: {
            text: "Regiões que mais compram",
            font: {
                size: 30,
                color: "#333333"
            }
        },

        paper_bgcolor: "rgba(0,0,0,0)",
        plot_bgcolor: "rgba(0,0,0,0)",

        font: {
            color: "#333333"
        },

        showlegend: true
    };

    const config = {
        responsive: true,
        displayModeBar: true
    };

    Plotly.newPlot("myPlot", data, layout, config);

</script>

<div id="carouselExample" class="carousel slide" data-bs-ride="carousel">

    <div class="carousel-inner">

        <div class="carousel-item active">
            <img src="https://images.unsplash.com/photo-1516321497487-e288fb19713f?q=80&w=1170&auto=format&fit=crop&ixlib=rb-4.1.0&ixid=NHwxMjA3fDA%3D" class="d-block w-100">

            <div class="carousel-caption">
                <h2>Tudo o que você procura, em um só lugar!</h2>
                <p>Encontre seus produtos favoritos com praticidade, variedade e poucos cliques.</p>
            </div>
        </div>

        <div class="carousel-item">
            <img src="https://images.unsplash.com/photo-1713947506242-8fcae733d158?q=80&w=1632&auto=format&fit=crop&ixlib=rb-4.1.0&ixid=NHwxMjA3fDA%3D" class="d-block w-100">

            <div class="carousel-caption">
                <h2>Grandes oportunidades esperam por você!</h2>
                <p>Explore ofertas e descubra produtos que combinam com seu estilo e suas necessidades. </p>
            </div>
        </div>

        <div class="carousel-item">
            <img src="https://plus.unsplash.com/premium_photo-1681488262364-8aeb1b6aac56?q=80&w=1170&auto=format&fit=crop&ixlib=rb-4.1.0&ixid=NHwxMjA3fDA%3D" class="d-block w-100">

            <div class="carousel-caption">
                <h2> Comprar online nunca foi tão fácil! </h2>
                <p> Navegue por diversas categorias e encontre o que precisa sem sair de casa.</p>
            </div>
        </div>

    </div>
    <button class="carousel-control-prev" type="button" data-bs-target="#carouselExample" data-bs-slide="prev">
        <span class="carousel-control-prev-icon" aria-hidden="true"></span>
        <span class="visually-hidden">Previous</span>
    </button>
    <button class="carousel-control-next" type="button" data-bs-target="#carouselExample" data-bs-slide="next">
        <span class="carousel-control-next-icon" aria-hidden="true"></span>
        <span class="visually-hidden">Next</span>
    </button>
</div>